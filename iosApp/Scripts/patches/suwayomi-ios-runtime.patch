+    }
+
+    private static int[] enumerateBits(long val) {
+        int[] result = new int[Long.bitCount(val)];
+        int index = 0;
+        int resource = 0;
+        while (val > 0) {
+            if ((val & 1) == 1) result[index++] = resource;
+            val = val >> 1;
+            resource++;
+        }
+        return result;
+    }
