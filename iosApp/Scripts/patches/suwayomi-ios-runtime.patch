+            mLinkDownBandwidthKbps = nc.mLinkDownBandwidthKbps;
+            mLinkUpBandwidthKbps = nc.mLinkUpBandwidthKbps;
+            mSignalStrength = nc.mSignalStrength;
+            mNetworkSpecifier = nc.mNetworkSpecifier;
+            mRequestorUid = nc.mRequestorUid;
+        }
+    }
